.page { padding: 24rpx 28rpx 48rpx; background: #f6efe0; min-height: 100vh; color: #2f2a24; }
.head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.seal { width: 72rpx; height: 72rpx; border: 2rpx solid #b4452f; color: #b4452f; display: flex; align-items: center; justify-content: center; border-radius: 12rpx; }
.title { font-size: 40rpx; }
.sub, .folder, .kind { display: block; color: #8a7358; font-size: 24rpx; }
.stage, .disc { width: 100%; height: 420rpx; border-radius: 24rpx; background: #1c1814; }
.disc { display: flex; align-items: center; justify-content: center; color: #b4452f; background: #f3e6d0; font-size: 48rpx; }
.lesson { display: block; font-size: 34rpx; margin: 8rpx 0; }
.transport, .rates { display: flex; gap: 12rpx; align-items: center; margin-top: 16rpx; }
.kind-title { margin-top: 28rpx; font-size: 32rpx; letter-spacing: 4rpx; }
.folder-title { margin: 12rpx 0; color: #a07a4e; font-size: 22rpx; }
.row { background: #fff; border-radius: 16rpx; padding: 18rpx 20rpx; margin-bottom: 12rpx; }
